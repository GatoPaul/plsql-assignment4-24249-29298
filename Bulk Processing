
CREATE OR REPLACE PROCEDURE apply_grade_curve (p_curve_amount IN NUMBER) IS
    
    TYPE t_enrollment_rec IS RECORD (
        enrollment_id enrollments.enrollment_id%TYPE,
        current_grade enrollments.grade%TYPE
    );
    TYPE t_enrollment_tab IS TABLE OF t_enrollment_rec INDEX BY PLS_INTEGER;
    
    v_enrollments t_enrollment_tab;
    
    
    e_bulk_errors EXCEPTION;
    PRAGMA EXCEPTION_INIT(e_bulk_errors, -24381);
BEGIN
    
    SELECT enrollment_id, grade
    BULK COLLECT INTO v_enrollments
    FROM enrollments
    WHERE status = 'ACTIVE' AND grade IS NOT NULL; -- Fetching active ones with grades

    
    IF v_enrollments.COUNT > 0 THEN
        FORALL i IN 1 .. v_enrollments.COUNT SAVE EXCEPTIONS
            UPDATE enrollments
            SET grade = LEAST(v_enrollments(i).current_grade + p_curve_amount, 100)
            WHERE enrollment_id = v_enrollments(i).enrollment_id;
            
        DBMS_OUTPUT.PUT_LINE('Bulk update completed for ' || SQL%ROWCOUNT || ' records.');
    ELSE
        DBMS_OUTPUT.PUT_LINE('No active records to update.');
    END IF;

    COMMIT;

EXCEPTION
    WHEN e_bulk_errors THEN
        DBMS_OUTPUT.PUT_LINE('Some updates failed during bulk processing.');
        FOR i IN 1 .. SQL%BULK_EXCEPTIONS.COUNT LOOP
            DBMS_OUTPUT.PUT_LINE('Error at index ' || SQL%BULK_EXCEPTIONS(i).ERROR_INDEX || 
                                 ': ' || SQLERRM(-SQL%BULK_EXCEPTIONS(i).ERROR_CODE));
        END LOOP;
        ROLLBACK;
    WHEN OTHERS THEN
        ROLLBACK;
        DBMS_OUTPUT.PUT_LINE('Error: ' || SQLERRM);
END;
/
